{
  "name": "gte-editor",
  "displayName": "GTE 生成式文本编辑器",
  "description": "基于 LLM 的分块式生成文本编辑器：提示词块引导生成，生成块流式续写、可暂停可手动编辑。",
  "version": "0.1.3",
  "publisher": "trae-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/worldlifedd/LLM_text_editor"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gte.openWebEditor",
        "title": "GTE: 打开 Web 编辑器",
        "category": "GTE"
      },
      {
        "command": "gte.showPanel",
        "title": "GTE: 打开生成控制面板（旧命令别名）",
        "category": "GTE"
      }
    ],
    "configuration": {
      "title": "GTE",
      "properties": {
        "gte.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8907",
          "description": "无头服务地址（python server.py 默认端口 8907）"
        },
        "gte.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "服务不可达时自动用 python 拉起 server.py"
        },
        "gte.pythonCommand": {
          "type": "string",
          "default": "python",
          "description": "启动 server.py 所用的 Python 命令"
        },
        "gte.serverScript": {
          "type": "string",
          "default": "",
          "description": "server.py 绝对路径；留空则自动在工作区与扩展目录查找"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js && tsc --noEmit -p tsconfig.json",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
